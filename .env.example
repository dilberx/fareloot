# Copy to .env and fill in. Never commit .env — the repo is public.

# Travelpayouts Data API token: https://www.travelpayouts.com/programs/100/tools/api
FARELOOT_TP_TOKEN=

# Optional affiliate marker, used only to build booking deep links.
FARELOOT_TP_MARKER=

# Telegram push. Create a bot with @BotFather, then message it once and read your
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
FARELOOT_TELEGRAM_BOT_TOKEN=
FARELOOT_TELEGRAM_CHAT_ID=
